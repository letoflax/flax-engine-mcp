<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Flax.Build passes /unsafe to every C# module (Builder.DotNet.cs); the bridge reads ProfilerGPU.Event.Name (char*). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>FLAX_EDITOR</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(FlaxEngineCSharpPath)' == ''">
    <FlaxEngineCSharpPath>$(FlaxEditorCSharpPath)</FlaxEngineCSharpPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="FlaxEngine.CSharp" HintPath="$(FlaxEngineCSharpPath)" Private="false" />
    <Compile Include="../../bridge/FlaxMcpBridge.cs" Link="FlaxMcpBridge.cs" />
  </ItemGroup>
</Project>
